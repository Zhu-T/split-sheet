# Generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=

# Discord Developer Portal > Applications > your app > OAuth2 (Client ID / Client Secret)
AUTH_DISCORD_ID=
AUTH_DISCORD_SECRET=

# Protects the daily Discord summary cron (Vercel sends it as a Bearer token). Generate: openssl rand -hex 32
CRON_SECRET=

# Neon Postgres connection string (Vercel Marketplace sets this automatically)
DATABASE_URL=
